# Telegram Bot Token (@BotFather dan olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Arizalar kelib tushadigan Telegram guruh ID raqami
GROUP_ID=-1001234567890

# Administrator Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=123456789

# Ma'lumotlar bazasi fayli
DB_NAME=massage_bot.db

# Google Calendar sozlamalari
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
# Google Cloud Service Account JSON (ixtiyoriy, agar fayl o'rniga env ishlatilsa)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

